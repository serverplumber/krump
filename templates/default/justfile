# Host-side orchestration for a krump project.
#
# Requires podman (not docker -- the rootless user namespace handling matters
# here) and just. Nix on the host is optional: recipes that need it fall back to
# running nix inside podman.
#
# This file is yours. `nix flake update` brings in new krump nix code; it does
# not touch this justfile, because `just` cannot import recipes out of a nix
# store path without a materialization step and a bootstrap chicken-and-egg.
# Copied, not imported, on purpose.

set shell := ["bash", "-euo", "pipefail", "-O", "globstar", "-c"]

# -----------------------------------------------------------------------------
# Config
# -----------------------------------------------------------------------------

# Single source of truth, shared with flake.nix, which reads the same file.
# Rename your project by editing `project-name`, then `just devcontainer-json`.
project_name := trim(shell("cat project-name"))

nix_image := "ghcr.io/nixos/nix"
podman := "podman"
workspace := "/workspace"
project_root := justfile_directory()
dev_image := "localhost/" + project_name + "-dev:latest"

nix_flags := "--extra-experimental-features nix-command --extra-experimental-features flakes"
nix_conf := "NIX_USER_CONF_FILES=" + workspace + "/.nix-config"

# SELinux relabeling is a Linux concept. On macOS the bind mount is virtiofs out
# of the podman machine, where :z can fail outright -- so drop it there.
z := if os() == "linux" { ":z" } else { "" }

_default:
    @just --list

# -----------------------------------------------------------------------------
# Guards
# -----------------------------------------------------------------------------

[no-exit-message]
_not-in-container:
    @[ ! -f /run/.containerenv ] || { echo "leave the container to run this" >&2; exit 1; }

# Checked at runtime, not at parse time. The old parse-time backtick meant every
# single `just` invocation -- `just --list` included -- shelled out to podman.
[no-exit-message]
_need-nix-store:
    @{{ podman }} volume inspect nix-store >/dev/null 2>&1 || { echo "nix-store volume is missing -- run 'just bootstrap' first" >&2; exit 1; }

# -----------------------------------------------------------------------------
# Bootstrap
# -----------------------------------------------------------------------------

# Start here: seed the persistent nix-store volume (downloads the world once).
bootstrap: devcontainer-json
    #!/usr/bin/env bash
    set -euo pipefail
    if {{ podman }} volume inspect nix-store >/dev/null 2>&1; then
        echo "nix-store volume already present."
        exit 0
    fi
    echo "Bootstrapping nix-store volume..."
    # Mount the volume somewhere that does NOT shadow /nix, then copy into it
    # explicitly. Mounting it straight onto /nix hides the image's own store --
    # which is where coreutils lives -- so the `cp` doing the seeding is itself
    # no longer on PATH: "crun: executable file `cp` not found in $PATH".
    {{ podman }} run --rm -v nix-store:/mnt/nix-store {{ nix_image }} \
      cp -a /nix/. /mnt/nix-store/
    echo "nix-store volume ready."

_devcontainer-json:
    #!/usr/bin/env bash
    cat <<EOF
    {
      "name": "{{ project_name }}",
      "image": "{{ dev_image }}",
      "remoteUser": "root",
      "mounts": [
        { "source": "nix-store", "target": "/nix", "type": "volume" }
      ],
      "runArgs": ["--userns=keep-id:uid=0,gid=0"]
    }
    EOF

# Generate .devcontainer/devcontainer.json from project-name.
devcontainer-json:
    @mkdir -p .devcontainer
    @just _devcontainer-json > .devcontainer/devcontainer.json

# Fail if the committed devcontainer.json has drifted from the generator.
check-devcontainer-json:
    @just _devcontainer-json | diff -u .devcontainer/devcontainer.json - || { echo "devcontainer.json is stale -- run 'just devcontainer-json'" >&2; exit 1; }

# -----------------------------------------------------------------------------
# Image plumbing
# -----------------------------------------------------------------------------

# Build an image with nix-in-podman and stream it straight into host podman.
# streamLayeredImage writes the tarball to stdout, `podman load` reads it from
# stdin: no tarball on disk, no registry, no cached artifact to go stale.
_load-image target: _not-in-container bootstrap
    {{ podman }} run --rm \
      -v {{ project_root }}:{{ workspace }}{{ z }} \
      -v nix-store:/nix \
      --userns keep-id:uid=0,gid=0 \
      -w {{ workspace }} \
      {{ nix_image }} \
      nix {{ nix_flags }} run .#{{ target }} | {{ podman }} load -q

_run-image image: _not-in-container _need-nix-store
    {{ podman }} run --rm -it \
      -v {{ project_root }}:{{ workspace }}{{ z }} \
      -v nix-store:/nix \
      --userns keep-id:uid=0,gid=0 \
      -e SHELL \
      -w {{ workspace }} \
      {{ image }}

# Run a nix command: on the host if nix is there, otherwise inside podman.
_nix +args:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v nix >/dev/null 2>&1; then
        nix {{ args }}
    else
        just _need-nix-store
        {{ podman }} run --rm \
          -v {{ project_root }}:{{ workspace }}{{ z }} \
          -v nix-store:/nix \
          -e {{ nix_conf }} \
          -w {{ workspace }} \
          {{ nix_image }} \
          nix {{ args }}
    fi

# Run a build command in the dev image -- or inline, if we are already in it.
# Both paths go through `bash -c` with just's own shell quoting, so the two
# behave identically instead of diverging on quoting the way `eval` did.
_build +cmd:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f /run/.containerenv ]; then
        bash -c {{ quote(cmd) }}
    else
        {{ podman }} run --rm \
          -v {{ project_root }}:{{ workspace }}{{ z }} \
          -v nix-store:/nix \
          --userns keep-id:uid=0,gid=0 \
          -w {{ workspace }} \
          {{ dev_image }} \
          bash -c {{ quote(cmd) }}
    fi

# -----------------------------------------------------------------------------
# Dev loop
# -----------------------------------------------------------------------------

# Build the dev image and drop into your $SHELL inside it.
dev: _not-in-container devcontainer run-dev

# Build the dev image and load it, so VSCode/JetBrains can pick it up.
devcontainer: _not-in-container devcontainer-json (_load-image "dev-image")

# Run the already-built dev image interactively.
run-dev: (_run-image dev_image)

# Run bare nix in a container, with the workspace mounted.
naked-nix: _not-in-container _need-nix-store
    {{ podman }} run -it --rm \
      -e {{ nix_conf }} \
      -v {{ project_root }}:{{ workspace }}{{ z }} \
      -v nix-store:/nix \
      --userns keep-id:uid=0,gid=0 \
      -w {{ workspace }} \
      {{ nix_image }}

# -----------------------------------------------------------------------------
# Containers
# -----------------------------------------------------------------------------

# Load the staticserver demo image.
staticserver: (_load-image "staticserver-image")

# Load the busybox-base demo image.
busykrump: (_load-image "busy-krump-image")

# Serve ./assets on :8080 with the staticserver image.
run-staticserver: staticserver
    mkdir -p {{ project_root }}/assets
    {{ podman }} run -it --rm \
      -v {{ project_root }}/assets:/assets{{ z }} \
      -p 8080:8080 \
      localhost/staticserver:latest

# Pin an external base image into containers/ as content-addressed nix.
update-base-image image tag: _need-nix-store
    #!/usr/bin/env bash
    set -euo pipefail
    output="containers/base-image-$(echo '{{ image }}' | tr '/' '-')-{{ tag }}.nix"
    # Write to a temp file and move on success: a failed prefetch must not leave
    # a truncated .nix file in the tree for nix to choke on later.
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    {{ podman }} run --rm \
      -v {{ project_root }}:{{ workspace }}{{ z }} \
      -v nix-store:/nix \
      -e {{ nix_conf }} \
      -w {{ workspace }} \
      {{ nix_image }} \
      nix run nixpkgs#nix-prefetch-docker -- --image-name '{{ image }}' --image-tag '{{ tag }}' \
      | sed -n '/^{/,$ p' > "$tmp"
    test -s "$tmp"
    mv "$tmp" "$output"
    echo "wrote $output"

# busybox base image example
update-busybox: (update-base-image "busybox" "latest")

# -----------------------------------------------------------------------------
# Demo pipeline
# -----------------------------------------------------------------------------

# Demo: README.md -> assets/index.html, with lowdown inside the dev container.
build:
    mkdir -p {{ project_root }}/assets
    @just _build "lowdown -s -Thtml README.md -o assets/index.html"

# Demo: the whole pattern -- build an artifact, drop it in a dir, serve it.
serve: build run-staticserver

# -----------------------------------------------------------------------------
# Checks and maintenance
# -----------------------------------------------------------------------------

# Everything a CI job would run: flake checks plus generated-file drift checks.
check: check-devcontainer-json
    @just _nix {{ nix_flags }} flake check

# Format the whole tree -- nix, shell, markdown, and this justfile.
fmt:
    @just _nix {{ nix_flags }} fmt

# Smoke test: build the dev image, run it, exercise the build pipeline.
test: devcontainer
    #!/usr/bin/env bash
    set -euo pipefail
    {{ podman }} run --rm {{ dev_image }} bash -c 'nix --version && git --version && just --version'
    just build
    test -s assets/index.html
    # The container ships its own, older just. Prove the justfile still parses
    # there, with the workspace mounted -- that is the in-container `_build` path.
    just _build "just --list >/dev/null"
    just check-devcontainer-json
    echo "smoke test passed."

# Show flake outputs.
flake-show:
    @just _nix {{ nix_flags }} flake show

# Update flake.lock. This is how you pull in a new krump.
update:
    @just _nix {{ nix_flags }} flake update

# Garbage collect the nix store.
gc:
    @just _nix {{ nix_flags }} store gc
